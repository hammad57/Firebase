{
  "rules": {
    ".read": false,
    ".write": false,
    "coinvault": {
      ".read": false,
      ".write": false,
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "wallets": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "ledger": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "moneyRequests": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "publicSettings": {
        ".read": "auth != null"
      }
    }
  }
}
